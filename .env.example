# Local mode binds to loopback. The explicit tunnel launcher configures its HTTPS origin.
PORT=3210
# Data defaults to .local/ in this app folder (not public/).
# MODEL_CHAT_DATA_DIR=C:\Users\your-name\Downloads\model-chat-data
# Optional: a generated 32+ character secret. Otherwise generated once in the data directory.
# BETTER_AUTH_SECRET=
# Optional setup defaults; run npm run setup:media after changing them.
# MODEL_CHAT_MEDIA_PYTHON=C:\path\to\python.exe
# MODEL_CHAT_WHISPER_MODEL=large-v3-turbo
